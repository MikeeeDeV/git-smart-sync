{
  "name": "git-smart-sync",
  "displayName": "Git Smart Branch Sync",
  "description": "Seamless multi-branch Git synchronization with interactive checkboxes right inside VS Code and Antigravity Source Control",
  "version": "1.0.0",
  "publisher": "mohamed-ayman",
  "author": {
    "name": "Mohamed Ayman"
  },
  "license": "MIT",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "sync",
    "branch",
    "multi-branch",
    "push",
    "scm",
    "source-control"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "gitSmartSync.views.branches",
          "name": "Git Smart Sync",
          "when": "scmRepositoryCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "gitSmartSync.sync",
        "title": "Sync to Selected Branches...",
        "icon": "$(sync)"
      },
      {
        "command": "gitSmartSync.syncAll",
        "title": "Sync All Branches",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitSmartSync.syncPreset",
        "title": "Sync Branch Preset...",
        "icon": "$(layers)"
      },
      {
        "command": "gitSmartSync.dryRun",
        "title": "Dry-Run Sync (Preview Only)",
        "icon": "$(eye)"
      },
      {
        "command": "gitSmartSync.prune",
        "title": "Prune Stale Remote Branches",
        "icon": "$(trash)"
      },
      {
        "command": "gitSmartSync.refreshView",
        "title": "Refresh Branches View",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitSmartSync.sync",
          "group": "navigation",
          "when": "scmRepositoryCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "gitSmartSync.refreshView",
          "group": "navigation",
          "when": "view == gitSmartSync.views.branches"
        },
        {
          "command": "gitSmartSync.sync",
          "group": "navigation",
          "when": "view == gitSmartSync.views.branches"
        }
      ],
      "view/item/context": [
        {
          "command": "gitSmartSync.syncPreset",
          "group": "inline",
          "when": "viewItem == presetItem"
        },
        {
          "command": "gitSmartSync.sync",
          "group": "inline",
          "when": "viewItem == branchItem"
        }
      ],
      "commandPalette": [
        {
          "command": "gitSmartSync.sync"
        },
        {
          "command": "gitSmartSync.syncAll"
        },
        {
          "command": "gitSmartSync.syncPreset"
        },
        {
          "command": "gitSmartSync.dryRun"
        },
        {
          "command": "gitSmartSync.prune"
        },
        {
          "command": "gitSmartSync.refreshView"
        }
      ]
    },
    "configuration": {
      "title": "Git Smart Branch Sync",
      "properties": {
        "gitSmartSync.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Git Smart Sync button in the editor status bar."
        },
        "gitSmartSync.defaultRemote": {
          "type": "string",
          "default": "origin",
          "description": "Default Git remote name to push and sync to."
        },
        "gitSmartSync.syncStrategy": {
          "type": "string",
          "enum": [
            "fast-forward",
            "force-with-lease"
          ],
          "default": "fast-forward",
          "description": "Branch synchronization strategy. 'fast-forward' aborts if divergence is detected to prevent accidental loss; 'force-with-lease' overrides remote if safe."
        },
        "gitSmartSync.autoPullBeforePush": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run 'git pull' before pushing the active branch."
        },
        "gitSmartSync.presets": {
          "type": "object",
          "default": {
            "release": [
              "main",
              "production"
            ],
            "development": [
              "dev",
              "staging"
            ]
          },
          "description": "Configured branch preset groups for quick multi-branch synchronization."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  }
}
