{
  "name": "git-smart-sync",
  "displayName": "Git Smart Branch Sync",
  "description": "Seamless multi-branch Git synchronization with interactive checkboxes right inside VS Code and Antigravity Source Control",
  "version": "1.0.0",
  "publisher": "mohamed-ayman",
  "author": {
    "name": "Mohamed Ayman"
  },
  "license": "MIT",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "sync",
    "branch",
    "multi-branch",
    "push",
    "scm",
    "source-control"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitSmartSync.sync",
        "title": "Sync to Selected Branches...",
        "icon": "$(sync)"
      },
      {
        "command": "gitSmartSync.syncAll",
        "title": "Sync All Branches",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitSmartSync.sync",
          "group": "navigation",
          "when": "scmRepositoryCount > 0"
        }
      ],
      "commandPalette": [
        {
          "command": "gitSmartSync.sync"
        },
        {
          "command": "gitSmartSync.syncAll"
        }
      ]
    },
    "configuration": {
      "title": "Git Smart Branch Sync",
      "properties": {
        "gitSmartSync.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Git Smart Sync button in the editor status bar."
        },
        "gitSmartSync.defaultRemote": {
          "type": "string",
          "default": "origin",
          "description": "Default Git remote name to push and sync to."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  }
}
